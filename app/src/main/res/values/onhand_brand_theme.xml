<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="onhand_canvas_light">#F9F8F5</color>
    <color name="onhand_surface_light">#FFFEFC</color>
    <color name="onhand_ink_light">#252522</color>
    <color name="onhand_muted_light">#625E57</color>
    <!-- Accent text and outline remain readable; filled actions use the soft peach token. -->
    <color name="onhand_accent_light">#79503E</color>
    <color name="onhand_primary_fill_light">#E5BBA6</color>
    <color name="onhand_primary_ink_light">#58382B</color>
    <color name="onhand_bubble_ink_light">#6B493B</color>
    <color name="onhand_focus_light">#79503E</color>
    <color name="onhand_canvas_dark">#191A19</color>
    <color name="onhand_surface_dark">#242523</color>
    <color name="onhand_ink_dark">#F3F2ED</color>
    <color name="onhand_muted_dark">#C1BEB6</color>
    <color name="onhand_accent_dark">#E7C1AD</color>
    <color name="onhand_primary_fill_dark">#D4A58E</color>
    <color name="onhand_primary_ink_dark">#58382B</color>
    <color name="onhand_bubble_ink_dark">#F2D9CB</color>
    <color name="onhand_focus_dark">#DDBCAA</color>
    <item type="id" name="onhand_glyph_spec"/>
    <item type="id" name="onhand_spinner_spec"/>
    <item type="id" name="onhand_primary_paint"/>
    <style name="OnHandTheme.Light" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/onhand_accent_light</item>
        <item name="android:colorBackground">@color/onhand_canvas_light</item>
        <item name="android:colorBackgroundFloating">@color/onhand_surface_light</item>
        <item name="android:windowBackground">@color/onhand_canvas_light</item>
        <item name="android:textColorPrimary">@color/onhand_ink_light</item>
        <item name="android:textColorSecondary">@color/onhand_muted_light</item>
        <item name="android:colorControlNormal">@color/onhand_muted_light</item>
        <item name="android:colorControlActivated">@color/onhand_accent_light</item>
        <item name="android:colorControlHighlight">#2479503E</item>
        <item name="android:alertDialogTheme">@style/OnHandDialog.Light</item>
        <item name="android:statusBarColor">@color/onhand_canvas_light</item>
        <item name="android:navigationBarColor">@color/onhand_canvas_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="OnHandTheme.Dark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/onhand_accent_dark</item>
        <item name="android:colorBackground">@color/onhand_canvas_dark</item>
        <item name="android:colorBackgroundFloating">@color/onhand_surface_dark</item>
        <item name="android:windowBackground">@color/onhand_canvas_dark</item>
        <item name="android:textColorPrimary">@color/onhand_ink_dark</item>
        <item name="android:textColorSecondary">@color/onhand_muted_dark</item>
        <item name="android:colorControlNormal">@color/onhand_muted_dark</item>
        <item name="android:colorControlActivated">@color/onhand_accent_dark</item>
        <item name="android:colorControlHighlight">#30E7C1AD</item>
        <item name="android:alertDialogTheme">@style/OnHandDialog.Dark</item>
        <item name="android:statusBarColor">@color/onhand_canvas_dark</item>
        <item name="android:navigationBarColor">@color/onhand_canvas_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="OnHandDialog.Light" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/onhand_accent_light</item>
        <item name="android:colorBackground">@color/onhand_surface_light</item>
        <item name="android:colorBackgroundFloating">@color/onhand_surface_light</item>
        <item name="android:windowBackground">@drawable/onhand_dialog_light</item>
        <item name="android:textColorPrimary">@color/onhand_ink_light</item>
        <item name="android:textColorSecondary">@color/onhand_muted_light</item>
        <item name="android:colorControlNormal">@color/onhand_muted_light</item>
        <item name="android:colorControlActivated">@color/onhand_accent_light</item>
        <item name="android:colorControlHighlight">#2479503E</item>
        <item name="android:backgroundDimAmount">0.42</item>
        <item name="android:windowMinWidthMinor">88%</item>
        <item name="android:windowMinWidthMajor">66%</item>
    </style>
    <style name="OnHandDialog.Dark" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/onhand_accent_dark</item>
        <item name="android:colorBackground">@color/onhand_surface_dark</item>
        <item name="android:colorBackgroundFloating">@color/onhand_surface_dark</item>
        <item name="android:windowBackground">@drawable/onhand_dialog_dark</item>
        <item name="android:textColorPrimary">@color/onhand_ink_dark</item>
        <item name="android:textColorSecondary">@color/onhand_muted_dark</item>
        <item name="android:colorControlNormal">@color/onhand_muted_dark</item>
        <item name="android:colorControlActivated">@color/onhand_accent_dark</item>
        <item name="android:colorControlHighlight">#30E7C1AD</item>
        <item name="android:backgroundDimAmount">0.54</item>
        <item name="android:windowMinWidthMinor">88%</item>
        <item name="android:windowMinWidthMajor">66%</item>
    </style>
</resources>
